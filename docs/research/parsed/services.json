        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "Jan"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "Audit planning for the new year. UAE VAT for the quarter to 31 December is due on the 28th."
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "Feb"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "Audit fieldwork for last year begins. UK VAT for the quarter to 31 December was due on the 7th."
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "Mar"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "Signed audit reports and management letters go out."
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "Apr"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "UAE VAT for the quarter to 31 March is due on the 28th."
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "May"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "UK VAT for the quarter to 31 March is due on the 7th."
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "Jun"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "Interim audit visits and early testing."
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "Jul"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "UAE VAT for the quarter to 30 June is due on the 28th."
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "Aug"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "UK VAT for the quarter to 30 June is due on the 7th."
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "Sep"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "UAE corporate tax returns for last year are due on the 30th, as are UK accounts at Companies House."
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "Oct"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "UAE VAT for the quarter to 30 September is due on the 28th. UK corporation tax is payable on the 1st."
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "Nov"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "UK VAT for the quarter to 30 September is due on the 7th."
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "Dec"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "UK company tax returns for last year are due on the 31st."
        },
        {
          "tag": "p",
          "cls": "services-year_foot text-size-small text-color-secondary",
          "text": "Every month closes by the tenth working day. Tax and audit dates assume calendar quarters and a 31 December year end."
        }
