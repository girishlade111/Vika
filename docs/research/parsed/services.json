      "texts": [
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "01"
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "Bookkeeping, payroll, management accounts"
        },
        {
          "tag": "h2",
          "cls": "services-practices_name heading-style-h1",
          "text": "Accounting"
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "01"
        },
        {
          "tag": "p",
          "cls": "text-size-large",
          "text": "We run your bookkeeping, payroll and management accounts every month and close the books by the tenth working day. You get one set of numbers that your board, your bank and your investors can all use."
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Bookkeeping in Xero, QuickBooks or Zoho Books"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Bank and card reconciliations every week"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Payroll, with WPS files for UAE teams"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Management accounts by the tenth working day"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "A cash flow forecast, rolled forward monthly"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "A named accountant who knows your business"
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "From"
        },
        {
          "tag": "p",
          "cls": "heading-style-h3",
          "text": "AED 2,500"
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "a month"
        },
        {
          "tag": "p",
          "cls": "text-weight-medium",
          "text": "Leo Brandt"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "Head of Accounting"
        },
        {
          "tag": "a",
          "cls": "button is-icon",
          "href": "/services/accounting",
          "text": "Read about the practicehow we work"
        },
        {
          "tag": "a",
          "cls": "text-style-link",
          "href": "/contact",
          "text": "Ask about this practice"
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "02"
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "VAT, corporate tax, registrations"
        },
        {
          "tag": "h2",
          "cls": "services-practices_name heading-style-h1",
          "text": "Tax"
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "02"
        },
        {
          "tag": "p",
          "cls": "text-size-large",
          "text": "We register you, keep the tax calendar and file every VAT and corporate tax return before it falls due, in the UAE and the UK. Nothing is filed until you have read it and approved it."
        },
        {
          "tag": "li",
          "cls": "",
          "text": "VAT and corporate tax registration"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Quarterly VAT returns in the UAE and the UK"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "The annual corporate tax return and computation"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Transfer pricing disclosures where they apply"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Small Business Relief checks for eligible companies"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Letters and reviews from the tax authority, handled"
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "From"
        },
        {
          "tag": "p",
          "cls": "heading-style-h3",
          "text": "AED 1,500"
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "a quarter"
        },
        {
          "tag": "p",
          "cls": "text-weight-medium",
          "text": "Rami Nassar"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "Tax Partner"
        },
        {
          "tag": "a",
          "cls": "button is-icon",
          "href": "/services/tax",
          "text": "Read about the practicehow we work"
        },
        {
          "tag": "a",
          "cls": "text-style-link",
          "href": "/contact",
          "text": "Ask about this practice"
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "03"
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "Statutory audit, licence renewals, group packs"
        },
        {
          "tag": "h2",
          "cls": "services-practices_name heading-style-h1",
          "text": "Audit"
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "03"
        },
        {
          "tag": "p",
          "cls": "text-size-large",
          "text": "Our audit team signs statutory audits for free zone and mainland companies in the UAE, and for UK companies that need one. We plan in the first month of your year, so year end is a review, not a rescue."
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Statutory audit of annual financial statements"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Audits for free zone licence renewals"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Reporting packs for overseas parent companies"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Agreed procedures and special purpose reports"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "A management letter you can act on"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Run as a separate team from our accounting practice"
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "From"
        },
        {
          "tag": "p",
          "cls": "heading-style-h3",
          "text": "AED 18,000"
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "an audit"
        },
        {
          "tag": "p",
          "cls": "text-weight-medium",
          "text": "Hannah Okoye"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "Audit Partner"
        },
        {
          "tag": "a",
