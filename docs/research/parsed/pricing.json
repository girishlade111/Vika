          "tag": "p",
          "cls": "text-style-label",
          "text": "Talk to a partner"
        },
        {
          "tag": "h2",
          "cls": "home-close_heading heading-style-h1",
          "text": "Talk to Sara."
        },
        {
          "tag": "p",
          "cls": "text-size-large",
          "text": "Thirty minutes with our managing partner. Bring your numbers, and by the end of the call you will know your fee."
        },
        {
          "tag": "p",
          "cls": "home-close_status text-style-label",
          "text": "Dubai office open Monday to Friday, 8:30 to 18:00"
        },
        {
