        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "Works with us on"
        },
        {
          "tag": "p",
          "cls": "text-size-regular",
          "text": "Accounting, payroll and tax"
        },
        {
          "tag": "span",
          "cls": "gsap_split_line gsap_split_line1",
