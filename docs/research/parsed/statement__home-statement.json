      "texts": [
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "(07) Questions"
        },
        {
          "tag": "h2",
          "cls": "questions_heading heading-style-h2",
          "text": "Asked often, answered plainly."
        },
        {
          "tag": "span",
          "cls": "text-color-tertiary",
          "text": "answered plainly."
        },
        {
          "tag": "a",
          "cls": "questions_question w-inline-block",
          "href": "#",
          "text": "Which accounting software do you work in?+"
        },
        {
          "tag": "h3",
          "cls": "questions_question-text heading-style-h4",
          "text": "Which accounting software do you work in?"
        },
        {
          "tag": "span",
          "cls": "questions_icon",
          "text": "+"
        },
        {
          "tag": "p",
          "cls": "questions_answer-text text-size-regular text-color-secondary",
          "text": "Xero, QuickBooks Online and Zoho Books. If you use something else, we will either work in it or move you, and we will tell you which costs less."
        },
        {
          "tag": "a",
          "cls": "questions_question w-inline-block",
          "href": "#",
          "text": "Can you take over halfway through the year?+"
        },
        {
          "tag": "h3",
          "cls": "questions_question-text heading-style-h4",
          "text": "Can you take over halfway through the year?"
        },
        {
          "tag": "span",
          "cls": "questions_icon",
          "text": "+"
        },
        {
          "tag": "p",
          "cls": "questions_answer-text text-size-regular text-color-secondary",
          "text": "Yes. Most clients join mid year. We rebuild the months before we started, so the year closes on one consistent set of books."
        },
        {
          "tag": "a",
          "cls": "questions_question w-inline-block",
          "href": "#",
          "text": "Do you audit companies whose books you keep?+"
        },
        {
          "tag": "h3",
          "cls": "questions_question-text heading-style-h4",
          "text": "Do you audit companies whose books you keep?"
        },
        {
          "tag": "span",
          "cls": "questions_icon",
          "text": "+"
        },
        {
          "tag": "p",
          "cls": "questions_answer-text text-size-regular text-color-secondary",
          "text": "No. Our audit team never audits a company that our accounting team works for. If you need both, we will introduce you to an audit firm we trust."
        },
        {
          "tag": "a",
          "cls": "questions_question w-inline-block",
          "href": "#",
          "text": "Who will I actually work with?+"
        },
        {
          "tag": "h3",
          "cls": "questions_question-text heading-style-h4",
          "text": "Who will I actually work with?"
        },
        {
          "tag": "span",
          "cls": "questions_icon",
          "text": "+"
        },
        {
          "tag": "p",
          "cls": "questions_answer-text text-size-regular text-color-secondary",
          "text": "A named accountant for the monthly work and a partner who reviews everything that leaves the building. You will have both of their numbers."
        },
        {
          "tag": "a",
          "cls": "questions_question w-inline-block",
          "href": "#",
          "text": "How do your fees work?+"
        },
        {
          "tag": "h3",
          "cls": "questions_question-text heading-style-h4",
          "text": "How do your fees work?"
        },
        {
          "tag": "span",
          "cls": "questions_icon",
          "text": "+"
        },
        {
          "tag": "p",
          "cls": "questions_answer-text text-size-regular text-color-secondary",
          "text": "Monthly work is a fixed fee agreed up front. Projects such as audits and registrations are quoted before we start. We do not bill by the hour."
        },
        {
          "tag": "a",
          "cls": "questions_question w-inline-block",
          "href": "#",
          "text": "Do you work outside the UAE and the UK?+"
        },
        {
          "tag": "h3",
          "cls": "questions_question-text heading-style-h4",
          "text": "Do you work outside the UAE and the UK?"
        },
        {
          "tag": "span",
          "cls": "questions_icon",
          "text": "+"
        },
        {
          "tag": "p",
          "cls": "questions_answer-text text-size-regular text-color-secondary",
          "text": "We look after group companies in Saudi Arabia, Bahrain and the EU through partner firms, coordinated by one team at Vika."
        }
