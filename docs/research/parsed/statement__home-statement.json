        {
          "tag": "p",
          "cls": "section-head_label text-style-label",
          "text": "(01) Practices"
        },
        {
          "tag": "h2",
          "cls": "section-head_heading heading-style-h2",
          "text": "Three practices, opened one at a time."
        },
        {
          "tag": "span",
          "cls": "text-color-tertiary",
          "text": "opened one at a time."
        },
        {
          "tag": "a",
          "cls": "practices_row is-summary w-inline-block",
          "href": "#",
          "text": "01AccountingMonthly books, closed by the tenth.FromAED 2,500a month+"
        },
        {
          "tag": "p",
          "cls": "practices_number text-style-label",
          "text": "01"
        },
        {
          "tag": "h3",
          "cls": "practices_name",
          "text": "Accounting"
        },
        {
          "tag": "p",
          "cls": "practices_short text-size-medium",
          "text": "Monthly books, closed by the tenth."
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "From"
        },
        {
          "tag": "p",
          "cls": "text-size-regular text-weight-medium",
          "text": "AED 2,500"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "a month"
        },
        {
          "tag": "span",
          "cls": "practices_icon is-plus",
          "text": "+"
        },
        {
          "tag": "p",
          "cls": "text-size-large",
          "text": "We run your bookkeeping, payroll and management accounts every month and close the books by the tenth working day. You get one set of numbers that your board, your bank and your investors can all use."
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Bookkeeping in Xero, QuickBooks or Zoho Books"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Bank and card reconciliations every week"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Payroll, with WPS files for UAE teams"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Management accounts by the tenth working day"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "A cash flow forecast, rolled forward monthly"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "A named accountant who knows your business"
        },
        {
          "tag": "a",
          "cls": "button is-icon",
          "href": "/services/accounting",
          "text": "Explore the practicesee the work"
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "Led by"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-weight-medium",
          "text": "Leo Brandt"
        },
        {
          "tag": "a",
          "cls": "practices_row is-summary w-inline-block",
          "href": "#",
          "text": "02TaxVAT and corporate tax, filed early.FromAED 1,500a quarter+"
        },
        {
          "tag": "p",
          "cls": "practices_number text-style-label",
          "text": "02"
        },
        {
          "tag": "h3",
          "cls": "practices_name",
          "text": "Tax"
        },
        {
          "tag": "p",
          "cls": "practices_short text-size-medium",
          "text": "VAT and corporate tax, filed early."
        },
        {
          "tag": "p",
          "cls": "text-style-label",
          "text": "From"
        },
        {
          "tag": "p",
          "cls": "text-size-regular text-weight-medium",
          "text": "AED 1,500"
        },
        {
          "tag": "p",
          "cls": "text-size-small text-color-secondary",
          "text": "a quarter"
        },
        {
          "tag": "span",
          "cls": "practices_icon is-plus",
          "text": "+"
        },
        {
          "tag": "p",
          "cls": "text-size-large",
          "text": "We register you, keep the tax calendar and file every VAT and corporate tax return before it falls due, in the UAE and the UK. Nothing is filed until you have read it and approved it."
        },
        {
          "tag": "li",
          "cls": "",
          "text": "VAT and corporate tax registration"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Quarterly VAT returns in the UAE and the UK"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "The annual corporate tax return and computation"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Transfer pricing disclosures where they apply"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Small Business Relief checks for eligible companies"
        },
        {
          "tag": "li",
          "cls": "",
          "text": "Letters and reviews from the tax authority, handled"
        },
        {
          "tag": "a",
          "cls": "button is-icon",
